{
  "name": "logidrom",
  "version": "1.2.0",
  "description": "Digital logic circuit rendering engine",
  "main": "./lib/",
  "repository": {
    "type": "git",
    "url": "https://github.com/drom/logidrom.git"
  },
  "author": "drom",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wavedrom/logidrom/issues"
  },
  "homepage": "https://github.com/wavedrom/logidrom",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "build/logidrom.js",
    "lib"
  ],
  "unpkg": "build/logidrom.js",
  "scripts": {
    "test": "eslint lib/ test/ && c8 -r text -r lcov mocha",
    "build": "esbuild lib/app.js --bundle --outfile=public/app.js",
    "bundle": "esbuild lib/index.js --bundle --format=iife --global-name=logidrom --footer:js=\"(function(r){if(typeof define=='function'&&define.amd){define([],()=>logidrom)}else if(typeof module=='object&&module.exports){module.exports=logidrom}else{r.logidrom=logidrom}})(typeof self!=='undefined'?self:this);\" --outfile=build/logidrom.js",
    "prepublish": "npm run test && mkdir -p build && npm run bundle"
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "ajv": "^8.20.0",
    "c8": "^10.1.3",
    "chai": "^6.3.0",
    "eslint": "^10.13.0",
    "esbuild": "^0.28.2",
    "globals": "^17.13.0",
    "mocha": "^12.0.3"
  },
  "dependencies": {
    "estraverse": "^5.1.0",
    "onml": "^2.1.0",
    "tspan": "^0.4.0"
  }
}
